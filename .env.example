# --- inventory + state ------------------------------------------------------

# Hosts and their allowed paths. See hosts.example.yaml.
AGENTMGR_INVENTORY=hosts.yaml

# sqlite registry: every session ever launched, plus cached preflight results.
AGENTMGR_DB_PATH=agentmgr.db

# --- API --------------------------------------------------------------------

# Required on every /api/fleet/v1 request. agentmgrd REFUSES TO START without
# one — an unset token must never mean "no auth required".
#   openssl rand -base64 32
AGENTMGR_API_TOKEN=

AGENTMGR_PORT=8000

# --- SSH --------------------------------------------------------------------

# Default identity. A host may override it with `identity:` in hosts.yaml.
# Use a DEDICATED key, not your personal one: this process is a remote-code-
# execution service for every host in the inventory.
AGENTMGR_SSH_KEY_FILE=~/.ssh/id_agentmgr

# The private key's PEM *contents*, which win over the file. This is the k8s
# Secret path — the key never touches disk in the pod. Leave empty locally.
AGENTMGR_SSH_KEY=

# Only if the key is encrypted. The CLI may prompt interactively instead;
# the server never prompts and will fail to start.
AGENTMGR_SSH_KEY_PASSPHRASE=

# Also offer identities from $SSH_AUTH_SOCK. Set false in a pod (no agent).
AGENTMGR_SSH_USE_AGENT=true

# Host key verification. Strict by default; onboard a host with
# `agentmgr hosts trust <host>`.
AGENTMGR_KNOWN_HOSTS=~/.ssh/known_hosts

# Skip host key verification entirely. Logs a warning on every dial. The CLI
# also takes --insecure-host-key for a single run.
AGENTMGR_SSH_INSECURE_HOST_KEY=false

AGENTMGR_SSH_TIMEOUT_S=20

# Kubeconfig for `transport: kubectl` hosts (workspace pods, SPEC.md §5.5).
# Unset: the in-cluster service account when running in the pod, else
# ~/.kube/config. From a workstation, point it at the cluster's:
#AGENTMGR_KUBECONFIG=../k8s-descriptors/.kubeconfig
AGENTMGR_EXEC_TIMEOUT_S=60

# --- runner / reconcile -----------------------------------------------------

# How long to poll for the agent's control URL. Not finding one is not a
# launch failure: the session stays usable via tmux and the log.
AGENTMGR_URL_SCRAPE_TIMEOUT_S=120

# Background liveness sweep. 0 disables it (the CLI still reconciles on `ls`).
AGENTMGR_RECONCILE_INTERVAL_S=30

# No log growth for this long => the session is reported `stale`.
AGENTMGR_STALE_AFTER_S=1800

# A started `claude auth login` session waits this long for its code, then is killed.
AGENTMGR_AUTH_LOGIN_TIMEOUT_S=600

# --- history (~/.claude/history.jsonl) -------------------------------------
# Read from every host this often; 0 disables the background collector (a pull
# on demand still works). Idempotent: re-reading a file inserts nothing twice.
AGENTMGR_HISTORY_PULL_INTERVAL_S=43200

# PRIVACY. true keeps each prompt's text (clipped to 2000 chars) in the registry,
# which lives on the PVC behind the API token. It is the user's own words and the
# work log needs it. false keeps only project/session/time, and the work log
# degrades to counts.
AGENTMGR_HISTORY_STORE_PROMPTS=true

# Substrings of project paths left out of every report (case-insensitive). The
# home directory itself is always excluded.
AGENTMGR_HISTORY_EXCLUDE=scratch,/.openclaw,/.claude

# The IANA zone whose midnight ends a day in the work log.
AGENTMGR_TZ=UTC

# Each launch is several round trips plus a git fetch.
AGENTMGR_MAX_CONCURRENT_LAUNCHES=4
