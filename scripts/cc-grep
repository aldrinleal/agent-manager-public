#!/usr/bin/env bash
# cc-grep / cc-kill: lista (e mata) sessões do Claude Code nesta máquina, com o projeto/repo de cada uma.
#
#   cc-grep [-a] [-l] [padrão]                       lista as sessões
#   cc-kill [-y] [-s SINAL|-9|--stop|--cont] [--self] padrão   sinaliza as que casam (confirma sem -y)
#
# -a       inclui processos auxiliares (ex.: --chrome-native-host)
# -l       mostra também diretório e comando
# --stop   congela (SIGSTOP) para depurar; --cont retoma (SIGCONT)
# --self   permite que cc-kill pegue a sessão de onde foi chamado (por padrão é pulada)
# O padrão é uma regex do grep -E, sem diferenciar maiúsculas, aplicada a repo, remote, branch,
# diretório, nome da sessão, sessionId, bridgeSessionId (session_...) e comando.
# Nome, status e ids vêm de ~/.claude/sessions/<pid>.json. cc-kill é um symlink para cc-grep.
set -euo pipefail

mode=grep
[[ "$(basename "$0")" == cc-kill ]] && mode=kill

all=0 long=0 yes=0 self=0 sig=TERM pattern=""
while (($#)); do
  case "$1" in
    -a|--all) all=1 ;;
    -l|--long) long=1 ;;
    --stop) sig=STOP ;;
    --cont) sig=CONT ;;
    -y|--yes) yes=1 ;;
    -s|--signal) sig="${2:?falta o sinal}"; shift ;;
    -9) sig=KILL ;;
    --self) self=1 ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; pattern="${1:-}"; break ;;
    -*) echo "opção desconhecida: $1" >&2; exit 2 ;;
    *) pattern="$1" ;;
  esac
  shift
done

if [[ $mode == kill && -z $pattern ]]; then
  echo "cc-kill: informe um padrão (use '.' para todas as sessões)" >&2
  exit 2
fi

# Sessão do Claude Code que é ancestral deste shell (para não se matar sem querer).
own_pid=""
p=$$
while [[ $p -gt 1 ]]; do
  if [[ "$(cat /proc/$p/comm 2>/dev/null)" == claude ]]; then own_pid=$p; break; fi
  p=$(awk '{print $4}' /proc/$p/stat 2>/dev/null || echo 1)
done

# PIDs do Claude Code: binário nativo (comm=claude) ou instalação via npm (node .../claude-code/cli.js).
mapfile -t pids < <(
  { pgrep -x claude || true; pgrep -f 'node .*@anthropic-ai/claude-code/cli\.js' || true; } | sort -nu
)

rows=() targets=()
for pid in "${pids[@]}"; do
  [[ -r /proc/$pid/cmdline ]] || continue
  args=$(tr '\0' ' ' < /proc/$pid/cmdline | sed 's/ $//')
  if ((!all)) && [[ $args == *--chrome-native-host* ]]; then continue; fi
  cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || echo '?')
  repo="-" branch="-" remote=""
  if top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
    repo=$(basename "$top")
    branch=$(git -C "$cwd" symbolic-ref --short -q HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null || echo '?')
    remote=$(git -C "$cwd" remote get-url origin 2>/dev/null | sed -E 's#^(git@|ssh://git@|https?://)##; s#:#/#; s#\.git$##' || true)
    [[ -n $remote ]] && repo=$remote
  fi
  name="-" status="-" sid="-" bridge=""
  meta=~/.claude/sessions/$pid.json
  if [[ -r $meta ]]; then
    IFS=$'\t' read -r name status sid bridge < <(
      jq -r '[.name // "-", .status // "-", .sessionId // "-", .bridgeSessionId // ""] | @tsv' "$meta"
    ) || true
  fi
  read -r tty etime < <(ps -o tty=,etime= -p "$pid" 2>/dev/null) || continue
  [[ "$(ps -o stat= -p "$pid")" == T* ]] && status="PARADO"
  flag=""
  [[ $pid == "$own_pid" ]] && flag="*"
  line="$pid$flag"$'\t'"$tty"$'\t'"$etime"$'\t'"$status"$'\t'"$repo"$'\t'"$branch"$'\t'"$name"$'\t'"${bridge:-$sid}"
  ((long)) && line+=$'\t'"${cwd/#$HOME/\~}"$'\t'"$args"
  if [[ -n $pattern ]] && ! grep -qiE -- "$pattern" <<<"$repo $branch $cwd $name $sid $bridge $args"; then continue; fi
  rows+=("$line")
  targets+=("$pid")
done

if ((${#rows[@]} == 0)); then
  echo "nenhuma sessão do Claude Code${pattern:+ casando com '$pattern'}" >&2
  exit 1
fi

{
  header='PID\tTTY\tTEMPO\tSTATUS\tREPO\tBRANCH\tNOME\tSESSÃO'
  ((long)) && header+='\tDIRETÓRIO\tCOMANDO'
  printf "$header\n"
  printf '%s\n' "${rows[@]}"
} | column -t -s $'\t'
[[ -n $own_pid ]] && [[ " ${targets[*]} " == *" $own_pid "* ]] && echo "(* = esta sessão)"

[[ $mode == grep ]] && exit 0

kill_list=()
for pid in "${targets[@]}"; do
  if [[ $pid == "$own_pid" ]] && ((!self)); then
    echo "pulando $pid (esta sessão; use --self para incluir)" >&2
    continue
  fi
  kill_list+=("$pid")
done
((${#kill_list[@]})) || { echo "nada a matar" >&2; exit 1; }

if ((!yes)); then
  tty_in=/dev/stdin
  { : </dev/tty; } 2>/dev/null && tty_in=/dev/tty
  read -r -p "Enviar SIG$sig para ${#kill_list[@]} processo(s) (${kill_list[*]})? [s/N] " ans <"$tty_in" || ans=""
  [[ $ans =~ ^[sSyY] ]] || { echo "cancelado"; exit 1; }
fi
kill -s "$sig" "${kill_list[@]}"
echo "SIG$sig enviado para: ${kill_list[*]}"
